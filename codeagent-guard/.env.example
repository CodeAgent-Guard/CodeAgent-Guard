# Provider preset: openai, anthropic, deepseek, qwen, zhipu, kimi,
# gemini, siliconflow, ollama, lmstudio, vllm, custom.
LLM_PROVIDER=openai
# Protocol is normally selected by the preset: openai or anthropic.
LLM_PROTOCOL=openai
LLM_BASE_URL=https://api.openai.com
LLM_MODEL=gpt-5.5
# Optional for local OpenAI-compatible services that do not require auth.
LLM_API_KEY=replace-me
# Safer alternative: keep the key in a chmod 600 file.
# LLM_API_KEY_FILE=/opt/codeagent-guard/.secrets/provider-api-key

# Comma-separated domains that do not need external-recipient confirmation.
GUARD_INTERNAL_DOMAINS=codeguard.local,localhost

# Comma-separated WSL paths that open_directory may open in Windows Explorer.
# Keep this list narrow. Windows paths are accepted when the full value is shell-quoted.
GUARD_OPEN_DIRECTORY_ROOTS=/mnt/c/Users/your-name/Desktop,/mnt/d/desktop

# Comma-separated WSL paths where external file CRUD may operate outside the
# workspace. External operations always require ASK approval. Keep this narrower
# than full disks; prefer a Desktop or demo folder.
GUARD_EXTERNAL_WRITE_ROOTS=/mnt/c/Users/your-name/Desktop

# Optional real SMTP transport. Without it, email is written to data/outbox/.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=agent@example.com
# SMTP_USER=
# SMTP_PASSWORD=
