{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codeagent_guard": {
      "type": "local",
      "command": ["python3", "run_mcp_server.py"],
      "cwd": ".",
      "enabled": true,
      "timeout": 10000,
      "environment": {
        "GUARD_WORKSPACE": ".",
        "GUARD_DATA_DIR": "./data"
      }
    }
  },
  "permission": {
    "*": "ask",
    "read": "ask",
    "edit": "ask",
    "glob": "ask",
    "grep": "ask",
    "bash": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": "deny",
    "doom_loop": "ask",
    "codeagent_guard_*": "allow"
  }
}
